{
  "format": "cerberus-animation-pack",
  "version": 2,
  "default": "00.png",
  "states": {
    "idle": {
      "gif": "performance.gif",
      "loop": true
    },
    "play": {
      "gif": "performance.gif",
      "loop": false
    },
    "guard": {
      "frames": [
        "00.png"
      ],
      "fps": 1,
      "loop": true,
      "anchored": true
    },
    "sleep": {
      "frames": [
        "00.png"
      ],
      "fps": 1,
      "loop": true,
      "anchored": true
    }
  }
}
